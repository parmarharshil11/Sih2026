# ─── App ──────────────────────────────────────────────────────
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── API ──────────────────────────────────────────────────────
PORT=4000

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://ccuser:ccpassword@localhost:5432/capacityconnect
POSTGRES_DB=capacityconnect
POSTGRES_USER=ccuser
POSTGRES_PASSWORD=ccpassword
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ─── MinIO / S3 Object Storage ────────────────────────────────
STORAGE_ADAPTER=local       # 'local' | 's3'
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=capacity-connect
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ─── Auth ─────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_IN_PRODUCTION
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (placeholder) ──────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@capacityconnect.local

# ─── AI Provider (pluggable) ──────────────────────────────────
AI_PROVIDER=stub   # 'openai' | 'anthropic' | 'stub'
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
